---
import BlogCard from './BlogCard.astro';
import { getBlogCardImage } from '../lib/media';
import { formatPostDate, publicHref, publicSlug } from '../lib/posts';

interface Props {
  posts: Array<any>;
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<section class="blog-listing">
  <div class="container">
    <p class="blog-listing__count">{posts.length} artikelen op deze pagina</p>
    <div class="blog-listing__grid">
      {posts.map((post) => (
        <BlogCard title={post.data.title} excerpt={post.data.description} image={getBlogCardImage(post.data, publicSlug(post), post.body ?? '')} date={formatPostDate(post.data)} href={publicHref(post)} />
      ))}
    </div>
    {totalPages > 1 && (
      <nav class="blog-pagination" aria-label="Blogpagina's">
        {currentPage > 1 && <a href={currentPage === 2 ? '/blog/' : `/blog/${currentPage - 1}/`}>Vorige</a>}
        {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
          <a href={page === 1 ? '/blog/' : `/blog/${page}/`} aria-current={page === currentPage ? 'page' : undefined}>{page}</a>
        ))}
        {currentPage < totalPages && <a href={`/blog/${currentPage + 1}/`}>Volgende</a>}
      </nav>
    )}
  </div>
</section>

<style>
  .blog-listing { padding: 4rem 0; }
  .blog-listing__count { text-align: center; color: var(--color-text-muted); margin-bottom: 2rem; font-size: 0.9rem; }
  .blog-listing__grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .blog-pagination { display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem; flex-wrap: wrap; }
  .blog-pagination a { padding: 0.5rem 0.8rem; border: 1px solid var(--color-primary); border-radius: var(--radius-sm); color: var(--color-primary); }
  .blog-pagination a[aria-current='page'] { background: var(--color-primary); color: var(--color-white); }
  @media (min-width: 600px) { .blog-listing__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .blog-listing__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
