---
import ScrapedContentPage from '../components/ScrapedContentPage.astro';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import { render } from 'astro:content';
import { readdirSync, readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { getAllPosts } from '../lib/posts';

export async function getStaticPaths() {
  const reservedSlugs = new Set([
    'blog', 'tuincentrum', 'planten', 'decoratie', 'gereedschap', 'overig',
    'planten-zaden', 'tuingerei', 'verbouwing', 'sitemap', 'plant',
    'planten-overzicht', 'images',
  ]);
  const dataDir = join(process.cwd(), 'src/data/scraped/bedrijf');
  const companySlugs = existsSync(dataDir)
    ? readdirSync(dataDir)
        .filter((file) => file.endsWith('.json'))
        .map((file) => file.replace(/\.json$/, ''))
        .filter((slug) => !reservedSlugs.has(slug) && !slug.startsWith('beste-'))
    : [];
  const companySlugSet = new Set(companySlugs);
  const posts = await getAllPosts();

  return [
    ...companySlugs.map((slug) => ({ params: { slug }, props: { type: 'company' as const, file: `${slug}.json` } })),
    ...posts
      .filter((entry) => !reservedSlugs.has(entry.id) && !/^\d+$/.test(entry.id) && !companySlugSet.has(entry.id))
      .map((entry) => ({ params: { slug: entry.id }, props: { type: 'post' as const, entry } })),
  ];
}

const { type, file, entry } = Astro.props;
let Content: Awaited<ReturnType<typeof render>>['Content'] | undefined;
let data: { title: string; description: string; h1: string; date: string; contentHtml: string } | undefined;

if (type === 'post') {
  ({ Content } = await render(entry));
} else {
  data = JSON.parse(readFileSync(join(process.cwd(), 'src/data/scraped/bedrijf', file), 'utf-8'));
  data.contentHtml = data.contentHtml.replace(/<h1[\s\S]*?<\/h1>/i, '').replace(/<p>\s*Laatst bijgewerkt:[\s\S]*?<\/p>/i, '');
}
---

{type === 'post' && Content ? (
  <BlogPostLayout entry={entry}><Content /></BlogPostLayout>
) : data ? (
  <ScrapedContentPage
    title={data.title}
    description={data.description}
    h1={data.h1}
    date={data.date}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Tuincentrum', href: '/tuincentrum/' },
      { label: data.h1 || data.title },
    ]}
    contentHtml={data.contentHtml}
    showToc={true}
  />
) : null}
