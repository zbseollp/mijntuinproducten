---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getAllPosts } from '../../lib/posts';

const PAGE_SIZE = 12;

export async function getStaticPaths() {
  const pageSize = 12;
  const posts = await getAllPosts();
  const totalPages = Math.ceil(posts.length / pageSize);

  return [
    ...Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
      params: { slug: String(index + 2) },
      props: {
        type: 'page' as const,
        posts: posts.slice((index + 1) * pageSize, (index + 2) * pageSize),
        page: index + 2,
        totalPages,
      },
    })),
    ...posts.flatMap((entry) => [
      { params: { slug: entry.id }, props: { type: 'redirect' as const, target: `/${entry.id}/` } },
      { params: { slug: `article/${entry.id}` }, props: { type: 'redirect' as const, target: `/${entry.id}/` } },
    ]),
  ];
}

const { type, posts, page, totalPages, target } = Astro.props;

if (type === 'redirect') {
  return Astro.redirect(target, 301);
}
---

<BaseLayout
  title={`Blog pagina ${page} - Mijn Tuin Producten`}
  description="Lees de laatste blogs over tuinieren, planten en tuinproducten."
>
  <section class="blog-hero">
    <div class="container">
      <h1 class="blog-hero__title">Blog</h1>
      <p class="blog-hero__subtitle">De laatste tips, trends en reviews voor mensen met groene vingers</p>
    </div>
  </section>
  <BlogListing posts={posts} currentPage={page} totalPages={totalPages} />
</BaseLayout>

<style>
  .blog-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); padding: 4rem 0; text-align: center; }
  .blog-hero__title { color: var(--color-white); margin-bottom: 0.75rem; }
  .blog-hero__subtitle { color: rgba(255, 255, 255, 0.8); font-size: 1.1rem; }
</style>
