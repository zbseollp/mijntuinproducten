---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getAllPosts } from '../../lib/posts';

const PAGE_SIZE = 12;
const posts = await getAllPosts();
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---

<BaseLayout title="Blog - Mijn Tuin Producten" description="Lees de laatste blogs over tuinieren, planten en tuinproducten.">
  <section class="blog-hero"><div class="container"><h1 class="blog-hero__title">Blog</h1><p class="blog-hero__subtitle">De laatste tips, trends en reviews voor mensen met groene vingers</p></div></section>
  <BlogListing posts={posts.slice(0, PAGE_SIZE)} currentPage={1} totalPages={totalPages} />
</BaseLayout>

<style>
  .blog-hero { background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%); padding: 4rem 0; text-align: center; }
  .blog-hero__title { color: var(--color-white); margin-bottom: 0.75rem; }
  .blog-hero__subtitle { color: rgba(255, 255, 255, 0.8); font-size: 1.1rem; }
</style>
